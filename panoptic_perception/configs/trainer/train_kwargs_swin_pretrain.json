{
    "model_kwargs":{
        "model_type":"swin-classifier",
        "cfg_path":"panoptic_perception/configs/models/swin_model/swin_model_cls.cfg",
        "device":"cuda:0"
    },

    "dataset_kwargs":{
        "root":"/workspace/data/imagenet",
        "train_batch_size": 128,
        "train_shuffle": true,
        "train_num_workers": 8,
        "train_preprocessor_kwargs":{
            "image_resize": [224, 224],
            "perform_augmentation": true,
            "augment_params": {
                "degrees": 0,
                "translate": 0.0,
                "scale": 0.0,
                "shear": 0,
                "hsv_h": 0.015,
                "hsv_s": 0.4,
                "hsv_v": 0.4,
                "salt_prob": 0.0,
                "pepper_prob": 0.0,
                "flip_prob": 0.5,
                "img_size": [224, 224]
            }
        },
        "val_batch_size": 128,
        "val_shuffle": false,
        "val_num_workers": 4,
        "val_preprocessor_kwargs":{
            "image_resize": [224, 224]
        }
    },

    "optimizer_kwargs": {
        "_type": "AdamW",
        "initial_lr": 1e-3,
        "weight_decay": 0.05,
        "betas": [0.9, 0.999],
        "warmup_epochs": 5,
        "groups": {}
    },

    "trainer_kwargs":{
        "output_dir": "swin-T-classifier-imageNet-pretrain",
        "is_training": true,
        "first_val_epoch": 0,
        "metric_eval_mode": "strict",
        "metric_average_mode": "macro",
        "epochs": 100,
        "monitor_train": true,
        "monitor_val": true,
        "gradient_clipping": 5.0,
        "checkpoint_idx": 2,
        "gradient_accumulation_steps": 8,
        "lr_scheduler_start_epoch": 4,
        "reload_optimizer": false,
        "reload_optimizer_with_initial_lr": false,
        "checkpoint_path": null,
        "wandb_project": "swin-classifier-imageNet-pretrain",
        "wandb_enabled": true,
        "use_ema": false,
        "ema_decay": 0.9999,
        "ema_warmup_steps": 2000
    },

    "loss_kwargs": {
        "_type":"image-classifier",
        "kwargs":{
            "criterion":"cross_entropy",
            "criterion_kwargs": {
                "weight": null,
                "label_smoothing": 0.1
            }
        }
    }
}
