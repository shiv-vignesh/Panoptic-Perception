{

    "model_kwargs":{
        "model_type":"swin-yolov5-fpn",
        "cfg_path":"panoptic_perception/configs/models/swin_model/swin-yolov5-672-1120-detection.cfg",
        "device":"cuda:0"
    },

    "dataset_kwargs": {
        "use_super_categories":true,
        "train_dataset_kwargs":{
            "images_dir": "/workspace/data/coco/train2017",
            "annotations_json_path":"/workspace/data/coco/annotations/instances_train2017.json",
            "train_batch_size": 8,
            "train_shuffle": true,
            "train_num_workers": 8,
            "preprocessor_kwargs":{
                "image_resize": [672, 1120],
                "perform_augmentation": true,
                "augment_params": {
                    "degrees": 5,
                    "translate": 0.05,
                    "scale": 0.15,
                    "shear": 2,
                    "hsv_h": 0.015,
                    "hsv_s": 0.4,
                    "hsv_v": 0.4,
                    "salt_prob": 0.005,
                    "pepper_prob": 0.005,
                    "flip_prob": 0.5,
                    "img_size": [672, 1120]
                },
                "advanced_aug": {
                    "mosaic_prob": 0.5,
                    "mixup_prob": 0.0,
                    "copy_paste_prob": 0.0
                }
            }                 
        },
        "val_dataset_kwargs":{
            "images_dir": "/workspace/data/coco/val2017",
            "annotations_json_path":"/workspace/data/coco/annotations/instances_val2017.json",
            "val_batch_size": 12,
            "val_shuffle": false,
            "val_num_workers": 4,
            "preprocessor_kwargs":{
                "image_resize": [672, 1120],
                "perform_augmentation": false
            }
        }
    },

    "optimizer_kwargs": {
        "_type": "AdamW",
        "initial_lr": 1e-4,
        "weight_decay": 0.05,
        "betas": [0.9, 0.999],
        "warmup_epochs": 5,
        "backbone_lr_scale": 0.1,
        "groups": {}
    },

    "lr_scheduler_kwargs":{
        "_type": "cosine",
        "linear_lr_kwargs":{
            "start_factor": 1.0,
            "end_factor": 0.01
        },
        "cosine_annealing_lr_kwargs":{
            "eta_min": 5e-6
        }
    },

    "loss_kwargs": {
        "detection":{
            "_type":"detection-loss-ATSS",
            "kwargs":{}
        },
        "loss_weights": {
            "_description": "Multi-task loss weights",
            "detection": 1.0
        }        
    },

    "trainer_kwargs":{
        "output_dir": "swin-T-yolov5-coco-pretrain",
        "is_training": true,
        "first_val_epoch": 0,
        "metric_eval_mode": "strict",
        "metric_average_mode": "macro",
        "epochs": 100,
        "monitor_train": true,
        "monitor_val": true,
        "gradient_clipping": 5.0,
        "checkpoint_idx": 2,
        "gradient_accumulation_steps": 4,
        "lr_scheduler_start_epoch": 5,
        "reload_optimizer": false,
        "reload_optimizer_with_initial_lr": false,
        "checkpoint_path": "/workspace/Panoptic-Perception/swin-T-classifier-imageNet-pretrain/best_models/val/best_model.pt",
        "wandb_project": "swin-yolov5-coco-pretrain",
        "wandb_enabled": true,
        "use_ema": false,
        "ema_decay": 0.9999,
        "ema_warmup_steps": 2000
    }

}
